    "iOS allows a limited number of pending notifications, so a rolling window of days is scheduled and refreshed each time the app is opened." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسمح iOS بعدد محدود من التنبيهات المعلّقة، لذا تتم جدولة نافذة متحركة من الأيام وتحديثها عند كل فتح للتطبيق."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS allows a limited number of pending notifications, so a rolling window of days is scheduled and refreshed each time the app is opened."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آی‌اواس تعداد محدودی اعلان در انتظار می‌پذیرد، بنابراین بازه‌ای چندروزه زمان‌بندی و در هر بار باز کردن برنامه به‌روز می‌شود."
          }
        }
      }
    },
